rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.level is number && data.level >= 1
        && data.xp is number && data.xp >= 0
        && data.gold is number && data.gold >= 0;
    }

    function isValidQuest(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.title is string && data.title.size() > 0 && data.title.size() <= 150
        && data.xpReward is number && data.xpReward >= 0
        && data.goldReward is number && data.goldReward >= 0;
    }

    function isValidInventoryItem(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.id is string && data.id.size() > 0 && data.id.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.cost is number && data.cost >= 0;
    }

    // Health / Connection Test
    match /test/connection {
      allow read: if true;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;

      // Quests
      match /quests/{questId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(questId) && isValidQuest(incoming());
        allow delete: if isOwner(userId) && isValidId(questId);
      }

      // Inventory
      match /inventory/{itemId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(itemId) && isValidInventoryItem(incoming());
        allow delete: if isOwner(userId) && isValidId(itemId);
      }
    }
  }
}
